<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sprint Volca — Profils Force-Vitesse</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏃</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
  // Filet de secours : si jsDelivr a échoué (bloqueur, réseau), on retente via cdnjs.
  if (typeof Chart === 'undefined') {
    document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"><\/script>');
  }
</script>
<style>
:root{
  --bg:#10141b;
  --bg-panel:#1a2029;
  --bg-panel-2:#212936;
  --bg-elevated:#262f3d;
  --border:#2b3340;
  --border-soft:#232a35;
  --text:#eef1f5;
  --text-muted:#93a0b2;
  --text-faint:#5d6878;
  --force:#ff6b47;
  --vitesse:#35c6cf;
  --equilibre:#e8b339;
  --neutral:#8993a2;
  --font-display:'Barlow Condensed', 'Arial Narrow', sans-serif;
  --font-body:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}
*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  background:
    radial-gradient(1200px 500px at 85% -10%, rgba(255,107,71,0.10), transparent 60%),
    radial-gradient(900px 400px at -10% 110%, rgba(53,198,207,0.08), transparent 60%),
    var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  -webkit-font-smoothing:antialiased;
}
::selection{background:rgba(255,107,71,0.35);}
a{color:inherit;}
button{font-family:inherit;}

.topbar{
  display:flex; align-items:center; justify-content:space-between; gap:24px;
  padding:22px clamp(16px,4vw,40px);
  border-bottom:1px solid var(--border);
}
.brand{display:flex; align-items:baseline; gap:12px; flex-wrap:wrap;}
.brand h1{
  font-family:var(--font-display); font-weight:700; letter-spacing:.01em;
  font-size:clamp(24px,3.4vw,34px); margin:0; line-height:1;
}
.brand h1 span{color:var(--force);}
.brand p{margin:0; color:var(--text-muted); font-size:14px;}
.topbar .meta{color:var(--text-faint); font-size:12.5px; text-align:right;}

.layout{
  display:grid;
  grid-template-columns:300px 1fr;
  min-height:calc(100vh - 86px);
}

.roster{
  border-right:1px solid var(--border);
  padding:18px 14px 24px;
  overflow-y:auto;
}
.roster-controls{display:flex; flex-direction:column; gap:8px; margin-bottom:14px;}
.search-input{
  background:var(--bg-panel-2); border:1px solid var(--border); color:var(--text);
  padding:9px 12px; border-radius:7px; font-size:14px; font-family:var(--font-body);
  width:100%;
}
.search-input:focus-visible{outline:2px solid var(--force); outline-offset:1px;}
.chip-row{display:flex; gap:6px; flex-wrap:wrap;}
.chip{
  background:var(--bg-panel-2); border:1px solid var(--border); color:var(--text-muted);
  padding:5px 10px; border-radius:999px; font-size:12.5px; cursor:pointer;
  transition:border-color .15s, color .15s, background .15s;
}
.chip:hover{color:var(--text);}
.chip[aria-pressed="true"]{color:var(--bg); background:var(--text); border-color:var(--text);}
.chip:focus-visible{outline:2px solid var(--force); outline-offset:1px;}

.roster-list{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:4px;}
.roster-item{
  display:block; width:100%; text-align:left; background:transparent; border:1px solid transparent;
  border-left:3px solid var(--rowcolor, var(--border)); border-radius:6px;
  padding:9px 10px; cursor:pointer; color:var(--text);
}
.roster-item:hover{background:var(--bg-panel-2);}
.roster-item.active{background:var(--bg-elevated); border-color:var(--border);}
.roster-item.active{border-left-color:var(--rowcolor);}
.roster-item:focus-visible{outline:2px solid var(--force); outline-offset:1px;}
.roster-item .nm{font-weight:600; font-size:14.5px;}
.roster-item .sub{font-size:12px; color:var(--text-muted); display:flex; justify-content:space-between; margin-top:2px;}
.roster-empty{color:var(--text-faint); font-size:13px; padding:12px 4px;}

main{padding:clamp(16px,3vw,36px); min-width:0;}

/* ---- Recap view ---- */
.recap-head{display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:18px;}
.recap-head h2{font-family:var(--font-display); font-weight:600; font-size:28px; margin:0;}
.recap-head p{color:var(--text-muted); margin:4px 0 0; font-size:14px; max-width:60ch;}
.sortbar{display:flex; gap:6px; align-items:center; font-size:12.5px; color:var(--text-faint);}
.sortbar select{
  background:var(--bg-panel-2); border:1px solid var(--border); color:var(--text);
  padding:6px 9px; border-radius:6px; font-size:13px; font-family:var(--font-body);
}

.table-wrap{overflow-x:auto; border:1px solid var(--border); border-radius:10px;}
table.recap{width:100%; border-collapse:collapse; font-size:13.5px; min-width:720px;}
table.recap th{
  text-align:left; font-weight:600; color:var(--text-muted); font-size:11.5px;
  text-transform:uppercase; letter-spacing:.04em; padding:10px 12px;
  border-bottom:1px solid var(--border); background:var(--bg-panel);
  position:sticky; top:0;
}
table.recap td{padding:9px 12px; border-bottom:1px solid var(--border-soft);}
table.recap tbody tr{cursor:pointer; transition:background .12s;}
table.recap tbody tr:hover{background:var(--bg-panel-2);}
table.recap tbody tr:last-child td{border-bottom:none;}
table.recap td.name{font-weight:600;}
.badge{
  display:inline-block; padding:3px 9px; border-radius:999px; font-size:11.5px; font-weight:600;
  border:1px solid currentColor;
}
.badge.force{color:var(--force);}
.badge.vitesse{color:var(--vitesse);}
.badge.equilibre{color:var(--equilibre);}
.sexe-tag{color:var(--text-faint); font-size:12px;}
.mini-bar{position:relative; width:72px; height:6px; background:var(--bg-elevated); border-radius:4px; overflow:hidden;}
.mini-bar i{position:absolute; inset:0 auto 0 0; background:var(--vitesse); border-radius:4px;}

/* ---- Player view ---- */
.player-view[hidden]{display:none;}
.back-btn{
  background:none; border:1px solid var(--border); color:var(--text-muted);
  padding:7px 13px; border-radius:7px; font-size:13px; cursor:pointer; margin-bottom:18px;
}
.back-btn:hover{color:var(--text); border-color:var(--text-faint);}
.back-btn:focus-visible{outline:2px solid var(--force); outline-offset:1px;}

.pv-header{display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap; margin-bottom:22px;}
.pv-title{display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;}
.pv-title h2{font-family:var(--font-display); font-weight:700; font-size:clamp(32px,5vw,46px); margin:0; line-height:1;}
.pv-badges{display:flex; gap:8px; align-items:center; flex-wrap:wrap;}
.hero-stat{text-align:right;}
.hero-stat .v{font-family:var(--font-display); font-weight:700; font-size:44px; line-height:1; color:var(--force);}
.hero-stat .u{color:var(--text-muted); font-size:13px;}

.poste-row{display:flex; align-items:center; gap:10px; margin-bottom:16px; font-size:13.5px; color:var(--text-muted);}
.poste-row select{
  background:var(--bg-panel-2); border:1px solid var(--border); color:var(--text);
  padding:7px 10px; border-radius:7px; font-size:13.5px; font-family:var(--font-body);
}
.compare-filter{margin-bottom:20px;}
.grid-2{display:grid; grid-template-columns:1.1fr .9fr; gap:20px; align-items:start;}
@media (max-width:980px){.grid-2{grid-template-columns:1fr;}}

.panel{
  background:var(--bg-panel); border:1px solid var(--border); border-radius:12px;
  padding:18px 20px 20px;
}
.panel h3{
  font-family:var(--font-display); font-weight:600; font-size:17px; margin:0 0 4px;
  letter-spacing:.01em;
}
.panel .hint{color:var(--text-faint); font-size:12px; margin:0 0 14px;}
.chart-box{position:relative; height:230px;}

.stat-bars{display:flex; flex-direction:column; gap:14px;}
.stat-bar-row .lbl{display:flex; justify-content:space-between; font-size:13px; margin-bottom:5px;}
.stat-bar-row .lbl b{font-weight:600;}
.stat-bar-row .lbl .val{font-variant-numeric:tabular-nums; color:var(--text);}
.stat-bar-row .delta{font-size:11.5px; color:var(--text-faint); font-variant-numeric:tabular-nums;}
.track{position:relative; height:8px; background:var(--bg-elevated); border-radius:4px;}
.track .fill{position:absolute; top:0; bottom:0; left:0; border-radius:4px; background:var(--neutral);}
.track .avg-tick{position:absolute; top:-3px; bottom:-3px; width:2px; background:var(--text-faint);}
.track .avg-tick::after{content:""; position:absolute; top:-3px; left:50%; transform:translateX(-50%); width:5px; height:5px; border-radius:50%; background:var(--text-faint);}

.splits-table{width:100%; border-collapse:collapse; font-size:13px; margin-top:4px;}
.splits-table th,.splits-table td{padding:7px 8px; text-align:center; border-bottom:1px solid var(--border-soft);}
.splits-table th{color:var(--text-faint); font-weight:500; font-size:11.5px;}
.splits-table td:first-child,.splits-table th:first-child{text-align:left; color:var(--text-muted);}

.text-block{font-size:14px; line-height:1.6; color:var(--text); white-space:pre-line;}
.text-block.muted{color:var(--text-muted);}

.span-2{grid-column:1/-1;}
.stack{display:flex; flex-direction:column; gap:20px;}

/* ---- Photos ---- */
.photo-strip{display:flex; gap:10px; overflow-x:auto; padding-bottom:4px;}
.photo-thumb{
  flex:0 0 auto; width:120px; cursor:pointer; border:1px solid var(--border); border-radius:8px;
  overflow:hidden; background:var(--bg-panel-2);
}
.photo-thumb img{display:block; width:100%; height:80px; object-fit:cover;}
.photo-thumb .cap{font-size:11px; color:var(--text-muted); text-align:center; padding:4px 0;}
.photo-thumb:focus-visible{outline:2px solid var(--force); outline-offset:1px;}
.photo-empty{color:var(--text-faint); font-size:13px;}

.lightbox[hidden]{display:none;}
.lightbox{
  position:fixed; inset:0; background:rgba(8,10,14,0.85); display:flex; align-items:center; justify-content:center;
  padding:30px; z-index:60; flex-direction:column; gap:14px;
}
.lightbox img{max-width:min(90vw,800px); max-height:70vh; border-radius:10px; border:1px solid var(--border);}
.lightbox .lb-cap{color:var(--text-muted); font-size:14px;}
.lightbox .lb-controls{display:flex; gap:10px; align-items:center;}
.lightbox button{
  background:var(--bg-panel-2); border:1px solid var(--border); color:var(--text);
  padding:7px 14px; border-radius:7px; cursor:pointer; font-size:13px;
}
.lightbox button:hover{border-color:var(--text-faint);}
.lightbox .lb-close{position:absolute; top:20px; right:24px; background:none; border:none; color:var(--text-muted); font-size:26px; cursor:pointer;}

/* ---- Yo-Yo / VMA ---- */
.yoyo-form{display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; margin-bottom:16px;}
.yoyo-field{display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--text-muted);}
.yoyo-field input, .yoyo-field select{
  background:var(--bg-panel-2); border:1px solid var(--border); color:var(--text);
  padding:8px 10px; border-radius:7px; font-size:13.5px; font-family:var(--font-body); min-width:110px;
}
.yoyo-add-btn{
  background:var(--force); border:none; color:#1a0d08; font-weight:600;
  padding:9px 16px; border-radius:7px; cursor:pointer; font-size:13.5px;
}
.yoyo-add-btn:hover{filter:brightness(1.08);}
.yoyo-current{
  display:flex; gap:28px; flex-wrap:wrap; margin-bottom:16px; padding:14px 16px;
  background:var(--bg-panel-2); border:1px solid var(--border); border-radius:10px;
}
.yoyo-current .kv{display:flex; flex-direction:column;}
.yoyo-current .kv .k{font-size:11px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.03em;}
.yoyo-current .kv .v{font-family:var(--font-display); font-size:24px; font-weight:600;}
.yoyo-log{width:100%; border-collapse:collapse; font-size:13px;}
.yoyo-log th{text-align:left; color:var(--text-faint); font-weight:500; font-size:11.5px; padding:6px 8px; border-bottom:1px solid var(--border);}
.yoyo-log td{padding:7px 8px; border-bottom:1px solid var(--border-soft);}
.yoyo-log .del-btn{background:none; border:none; color:var(--text-faint); cursor:pointer; font-size:15px;}
.yoyo-log .del-btn:hover{color:var(--force);}
.yoyo-note{font-size:11.5px; color:var(--text-faint); margin-top:10px; line-height:1.5;}
.yoyo-empty{color:var(--text-faint); font-size:13px;}

footer{
  border-top:1px solid var(--border); padding:16px clamp(16px,4vw,40px);
  display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;
  color:var(--text-faint); font-size:12.5px;
}
.lex-btn{
  background:var(--bg-panel-2); border:1px solid var(--border); color:var(--text-muted);
  padding:7px 13px; border-radius:7px; font-size:13px; cursor:pointer;
}
.lex-btn:hover{color:var(--text);}
a.lex-btn{text-decoration:none; display:inline-block;}

.modal-backdrop[hidden]{display:none;}
.modal-backdrop{
  position:fixed; inset:0; background:rgba(8,10,14,0.72); display:flex; align-items:center; justify-content:center;
  padding:24px; z-index:50;
}
.modal{
  background:var(--bg-panel); border:1px solid var(--border); border-radius:14px; max-width:640px; width:100%;
  max-height:80vh; overflow-y:auto; padding:22px 24px;
}
.modal h3{font-family:var(--font-display); font-size:22px; margin:0 0 14px;}
.modal dl{margin:0;}
.modal dt{font-weight:600; margin-top:12px;}
.modal dd{margin:4px 0 0; color:var(--text-muted); font-size:13.5px; line-height:1.5;}
.modal-close{
  position:absolute; top:18px; right:18px; background:none; border:none; color:var(--text-muted);
  font-size:20px; cursor:pointer;
}
.modal-inner{position:relative;}

@media (prefers-reduced-motion:no-preference){
  .roster-item, .back-btn, .chip, .lex-btn{transition:background .12s,border-color .12s,color .12s;}
}

/* ===== Ajouts : filtres repliables, passes facultatives ===== */
.roster-top{display:flex; gap:8px;}
.roster-top .search-input{flex:1; min-width:0;}
.filter-panel{display:flex; flex-direction:column; gap:8px;}
.filters-toggle{
  display:none; align-items:center; gap:7px; background:var(--bg-panel-2); border:1px solid var(--border);
  color:var(--text); padding:0 14px; border-radius:7px; font-size:14px; min-height:44px; cursor:pointer;
}
.filters-toggle[aria-expanded="true"]{border-color:var(--text-faint);}
.filters-toggle:focus-visible{outline:2px solid var(--force); outline-offset:1px;}
.chip-count{
  display:inline-flex; align-items:center; justify-content:center; min-width:20px; height:20px; padding:0 6px;
  border-radius:999px; background:var(--force); color:#1a0d08; font-size:12px; font-weight:700;
}
.chip-count[hidden]{display:none;}
.result-count{margin:0 0 10px; color:var(--text-faint); font-size:12.5px;}
.recap-empty td{color:var(--text-faint); padding:18px 12px; cursor:default;}
table.recap tbody tr.recap-empty:hover{background:transparent; cursor:default;}
table.recap tbody tr:focus-visible{outline:2px solid var(--force); outline-offset:-2px;}
.opt{display:block; color:var(--text-faint); font-size:11px; font-weight:400;}
.form-msg{color:var(--force); font-size:12.5px; margin:-6px 0 12px;}
.form-msg:empty{display:none;}
.na{color:var(--text-faint);}
.yoyo-current .kv .d{font-size:11px; color:var(--text-faint); margin-top:1px;}

@media (max-width:980px){
  .grid-2{grid-template-columns:minmax(0,1fr);}
  .panel{min-width:0;}
}

/* ===== Tablette / téléphone ===== */
@media (max-width:860px){
  body{padding-left:env(safe-area-inset-left); padding-right:env(safe-area-inset-right);}
  .topbar{flex-direction:column; align-items:flex-start; gap:6px; padding:14px 16px;}
  .topbar .meta{text-align:left; font-size:12px;}
  .layout{grid-template-columns:1fr; min-height:0;}
  body.in-player .roster{display:none;}
  .roster{border-right:none; border-bottom:1px solid var(--border); padding:12px 14px; overflow:visible;}
  .roster-list{display:none;}
  .roster-controls{margin-bottom:0;}
  .filters-toggle{display:inline-flex;}
  .filter-panel{display:none; margin-top:10px;}
  .roster.open .filter-panel{display:flex;}
  .search-input,.sortbar select,.poste-row select,.yoyo-field input,.yoyo-field select{font-size:16px; min-height:44px;}
  .chip{padding:9px 14px; font-size:13.5px; min-height:40px;}
  main{padding:14px 14px 28px;}
  .recap-head{margin-bottom:12px;}
  .recap-head h2{font-size:24px;}
  .recap-head p{font-size:13.5px;}
  .sortbar{width:100%; gap:10px;}
  .sortbar select{flex:1;}

  .back-btn{
    position:sticky; top:8px; z-index:20; background:var(--bg-panel); color:var(--text);
    padding:10px 14px; min-height:44px; font-size:14px; margin-bottom:14px;
    box-shadow:0 4px 14px rgba(0,0,0,.35);
  }
  .pv-header{align-items:flex-start; gap:10px; margin-bottom:16px;}
  .hero-stat{text-align:left;}
  .hero-stat .v{font-size:38px;}
  .poste-row{flex-wrap:wrap;}
  .poste-row select{flex:1; min-width:160px;}
  .panel{padding:14px 14px 16px; border-radius:10px;}
  .grid-2{gap:14px;}
  .chart-box{height:210px;}
  .photo-thumb{width:140px;}
  .photo-thumb img{height:96px;}
  .splits-table{display:block; overflow-x:auto; white-space:nowrap;}
  .splits-table th,.splits-table td{padding:8px 7px;}

  .yoyo-form{display:grid; grid-template-columns:1fr 1fr; gap:10px; align-items:end;}
  .yoyo-form.passe-form{grid-template-columns:repeat(3,minmax(0,1fr));}
  .yoyo-field{min-width:0;}
  .yoyo-field.full{grid-column:1/-1;}
  .yoyo-field input,.yoyo-field select{min-width:0; width:100%;}
  .yoyo-add-btn{grid-column:1/-1; min-height:46px; font-size:15px;}
  .yoyo-current{display:grid; grid-template-columns:1fr 1fr; gap:12px; padding:12px 14px;}
  table.yoyo-log{display:block; overflow-x:auto; white-space:nowrap;}
  .yoyo-log .del-btn{font-size:22px; padding:4px 12px;}
  .stat-bar-row .delta{line-height:1.4;}

  .lightbox{padding:16px 12px;}
  .lightbox img{max-width:100%; max-height:62vh;}
  .lightbox button{padding:11px 16px; min-height:44px;}
  .lightbox .lb-close{top:8px; right:10px; font-size:30px; padding:6px 12px; min-height:0;}
  .modal-backdrop{padding:12px;}
  .modal{padding:18px 16px; max-height:88vh;}
  .modal-close{padding:8px 12px; font-size:24px; top:8px; right:8px;}

  footer{flex-direction:column; align-items:stretch; padding-bottom:calc(16px + env(safe-area-inset-bottom));}
  footer > span:last-child{flex-direction:column;}
  footer .lex-btn{display:block; text-align:center; min-height:44px; padding:12px;}
}

/* ===== Récapitulatif en cartes sur téléphone ===== */
@media (max-width:760px){
  .table-wrap{border:none; border-radius:0; overflow:visible;}
  table.recap, table.recap tbody{display:block; width:100%; min-width:0;}
  table.recap thead{display:none;}
  table.recap tbody{display:flex; flex-direction:column; gap:10px;}
  table.recap tbody tr{
    display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px 10px; padding:13px 14px;
    background:var(--bg-panel); border:1px solid var(--border);
    border-left:3px solid var(--rowcolor, var(--border)); border-radius:10px;
  }
  table.recap tbody tr:hover{background:var(--bg-panel);}
  table.recap tbody tr:active{background:var(--bg-panel-2);}
  table.recap td{display:block; padding:0; border:none; font-size:14px; font-variant-numeric:tabular-nums; min-width:0;}
  table.recap tbody tr:last-child td{border-bottom:none;}
  table.recap td[data-label]::before{
    content:attr(data-label); display:block; font-size:11px; font-weight:400;
    color:var(--text-faint); margin-bottom:2px;
  }
  table.recap td.name{grid-column:1/-1; font-size:17px;}
  table.recap td.c-profil{grid-column:1/3;}
  table.recap td.c-poste{grid-column:3/4; text-align:right; color:var(--text-muted); font-size:13px; align-self:center;}
