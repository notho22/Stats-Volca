  sexeWrap.querySelectorAll('.chip').forEach(btn=>btn.addEventListener('click',()=>{ state.sexe=btn.dataset.sexe; renderAll(); }));
  profilWrap.querySelectorAll('.chip').forEach(btn=>btn.addEventListener('click',()=>{ state.profil=btn.dataset.profil; renderAll(); }));
  // Postes : cumulatif (ex. Middle + Link) ; « Tous postes » remet à zéro.
  posteWrap.querySelectorAll('.chip').forEach(btn=>btn.addEventListener('click',()=>{
    if(btn.dataset.all){ state.poste.clear(); }
