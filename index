  const posteOpts = POSTES.map(p=>[p,p]).concat([['','Non renseigné']]);
  sexeWrap.innerHTML = sexeOpts.map(([v,l])=>`<button class="chip" data-sexe="${v}" aria-pressed="${state.sexe===v}">${l}</button>`).join('');
  profilWrap.innerHTML = profilOpts.map(([v,l])=>`<button class="chip" data-profil="${v}" aria-pressed="${state.profil===v}">${l}</button>`).join('');
  posteWrap.innerHTML = `<button class="chip" data-all="1" aria-pressed="${state.poste.size===0}">Tous postes</button>`
