function renderStatBars(name, p, comparisonGroup){
  const metrics = ['F0','V0','Pmax','FVslope','RFmax','Drf','Vopt','MaxSpeed'];
  const barsHtml = metrics.map(m=>{
    const stat = groupMeanStd(comparisonGroup, m);
    const v = p[m];
    const lo = Math.min(stat.min, v), hi = Math.max(stat.max, v);
    const range = (hi-lo) || 1;
    const fillPct = Math.max(2, Math.min(100, ((v-lo)/range)*100));
    const avgPct = Math.max(0, Math.min(100, ((stat.mean-lo)/range)*100));
    const goodHigh = METRIC_GOOD_HIGH[m];
    let color = '#8993a2';
    if(goodHigh!==null){ color = v >= stat.mean ? '#35c6cf' : '#ff6b47'; }
    const delta = v - stat.mean;
    const sign = delta>=0?'+':'';
    return `<div class="stat-bar-row">
      <div class="lbl"><span><b>${METRIC_LABEL[m]}</b></span><span class="val">${METRIC_FMT(m,v)}${METRIC_UNIT[m]?(' '+METRIC_UNIT[m]):''}</span></div>
      <div class="track"><div class="fill" style="width:${fillPct}%; background:${color}"></div><div class="avg-tick" style="left:${avgPct}%"></div></div>
      <div class="delta">${sign}${METRIC_FMT(m,delta)}${METRIC_UNIT[m]?(' '+METRIC_UNIT[m]):''} vs moyenne du groupe sélectionné (point = moyenne)</div>
    </div>`;
  }).join('');
  document.getElementById('stat-bars').innerHTML = barsHtml;
}

