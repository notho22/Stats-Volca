    ? `<tr><th>Date</th><th>Version</th><th>Distance</th><th>VO2max</th><th>VMA</th><th></th></tr>${tbody}`
    : '';
  table.querySelectorAll('.del-btn').forEach(btn=>btn.addEventListener('click', ()=>{
