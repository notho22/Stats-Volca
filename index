      const v = btn.dataset.poste;
      state.poste.has(v) ? state.poste.delete(v) : state.poste.add(v);
    }
    renderAll();
  }));
  const active = (state.sexe!=='TOUS') + (state.profil!=='TOUS') + (state.poste.size>0 ? 1 : 0);
  const cnt = document.getElementById('filters-count');
  cnt.textContent = active || '';
  cnt.hidden = !active;
}

