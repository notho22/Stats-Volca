  const open = document.querySelector('.roster').classList.toggle('open');
  document.getElementById('filters-toggle').setAttribute('aria-expanded', String(open));
});

document.getElementById('search').addEventListener('input', e=>{ state.search = e.target.value; renderAll(); });
document.getElementById('sort-select').addEventListener('change', e=>{ state.sort = e.target.value; renderAll(); });

document.getElementById('lex-open').addEventListener('click', ()=>{
  document.getElementById('lex-content').innerHTML = lexique.map(l=>`<dt>${l.mesure}</dt><dd>${l.explication}</dd>`).join('');
  document.getElementById('lex-modal').hidden = false;
});
document.getElementById('lex-close').addEventListener('click', ()=>{ document.getElementById('lex-modal').hidden = true; });
document.getElementById('lex-modal').addEventListener('click', e=>{ if(e.target.id==='lex-modal') e.target.hidden = true; });

document.getElementById('export-btn').addEventListener('click', ()=>{
  const joueurs = {};
  order.forEach(n=>{
    joueurs[n] = {
      ...players[n],
      poste: getPoste(n) || null,
      yoyo: getYoyoEntries(n),
      passe: getPasseEntries(n)
    };
  });
  const exportObj = {
    meta: {
      titre: 'Sprint Volca — Profils Force-Vitesse',
      date_export: new Date().toISOString().slice(0,10),
      nombre_joueurs: order.length,
      note: "Export complet depuis l'application : données de sprint (statiques, embarquées dans la page) + poste, tests Yo-Yo/VMA et qualité de passe (saisis et stockés localement dans ce navigateur)."
    },
    joueurs,
    ordre_joueurs: order,
    lexique_mesures: lexique
  };
  const blob = new Blob([JSON.stringify(exportObj, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `Stats_Volca_export_${exportObj.meta.date_export}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
});

renderAll();
</script>
