  try{ localStorage.setItem(posteKey(name), value); }catch(e){ /* stockage indisponible */ }
}

/* ---------- Groupe de comparaison dynamique (sexe + poste, cumulatif) ---------- */
function comparisonNames(){
  const sexeSel = compareFilter.sexe;
  const posteSel = compareFilter.poste;
  let list = order.filter(n=>{
    const p = players[n];
    const sexeOk = sexeSel.size===0 || sexeSel.has(p.sexe);
    const posteOk = posteSel.size===0 || posteSel.has(getPoste(n));
    return sexeOk && posteOk;
  });
  compareFallback = list.length===0;
  if(compareFallback) list = order.slice(); // filet de sécurité si la sélection ne matche personne
  return list;
}
function groupMeanStd(names, metric){
  const vals = names.map(n=>players[n][metric]).filter(v=>v!=null);
  const m = vals.reduce((a,b)=>a+b,0)/vals.length;
  const variance = vals.reduce((a,b)=>a+(b-m)*(b-m),0)/vals.length;
  return { mean:m, std:Math.sqrt(variance), min:Math.min(...vals), max:Math.max(...vals) };
}
function groupSegAvg(names){
  const out = [];
  for(let i=0;i<6;i++){
    const vals = names.map(n=>players[n].seg_speed[i]).filter(v=>v!=null);
    out.push(vals.reduce((a,b)=>a+b,0)/vals.length);
  }
  return out;
}

/* ---------- Yo-Yo test / VMA (stockage local au navigateur) ---------- */
function yoyoKey(name){ return 'sprintVolca.yoyo.' + name; }
function getYoyoEntries(name){
  try{
    const raw = localStorage.getItem(yoyoKey(name));
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}
function saveYoyoEntries(name, entries){
  try{ localStorage.setItem(yoyoKey(name), JSON.stringify(entries)); }catch(e){ /* stockage indisponible */ }
}
function computeVO2max(version, distance){
  return version==='IR2' ? distance*0.0136 + 45.3 : distance*0.0084 + 36.4;
}
function computeVMA(vo2max){ return vo2max/3.5; }
function latestYoyo(name){
  const entries = getYoyoEntries(name);
  if(!entries.length) return null;
  return [...entries].sort((a,b)=> b.date.localeCompare(a.date))[0];
}

/* ---------- Qualité de passe (stockage local, même logique que Yo-Yo) ---------- */
function passeKey(name){ return 'sprintVolca.passe.' + name; }
function getPasseEntries(name){
  try{
    const raw = localStorage.getItem(passeKey(name));
    return raw ? JSON.parse(raw) : [];
  }catch(e){ return []; }
}
function savePasseEntries(name, entries){
  try{ localStorage.setItem(passeKey(name), JSON.stringify(entries)); }catch(e){ /* stockage indisponible */ }
}
const PASSE_KEYS = ['r10','r15','r20'];
// Chaque distance est facultative : pour chacune, on prend la valeur la plus récente renseignée.
function latestPasse(name){
  const entries = [...getPasseEntries(name)].sort((a,b)=> (b.date||'').localeCompare(a.date||''));
  if(!entries.length) return null;
  const out = { date: entries[0].date, r10:null, r15:null, r20:null, d10:null, d15:null, d20:null };
  PASSE_KEYS.forEach(k=>{
    const e = entries.find(en=> en[k]!=null && !isNaN(en[k]));
    if(e){ out[k] = e[k]; out['d'+k.slice(1)] = e.date; }
  });
  if(PASSE_KEYS.every(k=>out[k]===null)) return null;
  return out;
}

function filteredSortedNames(){
  let list = order.filter(n=>{
    const p = players[n];
    if(state.sexe!=='TOUS' && p.sexe!==state.sexe) return false;
    if(state.profil!=='TOUS' && p.groupe!==state.profil) return false;
    if(state.poste.size && !state.poste.has(getPoste(n))) return false;
    if(state.search && !n.toLowerCase().includes(state.search.toLowerCase())) return false;
    return true;
  });
  list.sort((a,b)=>{
    if(state.sort==='name') return a.localeCompare(b);
    if(state.sort==='groupe') return (players[a].groupe||'').localeCompare(players[b].groupe||'');
    if(state.sort==='poste') return (getPoste(a)||'~').localeCompare(getPoste(b)||'~') || a.localeCompare(b);
    return (players[b][state.sort]||0) - (players[a][state.sort]||0);
  });
  return list;
}

