  const table = document.getElementById('passe-log');
  table.innerHTML = entries.length
    ? `<tr><th>Date</th><th>10 m</th><th>15 m</th><th>20 m</th><th></th></tr>${tbody}`
    : '';
  table.querySelectorAll('.del-btn').forEach(btn=>btn.addEventListener('click', ()=>{
    const remaining = getPasseEntries(name).filter(en=>en.id!==btn.dataset.id);
    savePasseEntries(name, remaining);
    renderPasse(name);
    renderComparisonViews();
    renderRecap();
  }));
}

document.getElementById('passe-add').addEventListener('click', ()=>{
  if(!currentPlayer) return;
  const msg = document.getElementById('passe-msg');
  const date = document.getElementById('passe-date').value || new Date().toISOString().slice(0,10);
  // Champ vide = null (non testé). Valeur invalide = NaN.
  const read = id=>{
    const raw = document.getElementById(id).value.trim();
    if(raw==='') return null;
    const v = parseInt(raw, 10);
    return (isNaN(v) || v<0) ? NaN : v;
  };
  const vals = { r10:read('passe-10'), r15:read('passe-15'), r20:read('passe-20') };
  if(Object.values(vals).some(v=>Number.isNaN(v))){
    msg.textContent = 'Saisissez des nombres entiers positifs, ou laissez le champ vide.';
    return;
  }
  if(Object.values(vals).every(v=>v===null)){
    msg.textContent = 'Renseignez au moins une distance (10, 15 ou 20 m). Les autres restent facultatives.';
    document.getElementById('passe-10').focus();
    return;
  }
  msg.textContent = '';
  const entries = getPasseEntries(currentPlayer);
  entries.push({ id: Date.now().toString(36), date, r10: vals.r10, r15: vals.r15, r20: vals.r20 });
  savePasseEntries(currentPlayer, entries);
  ['passe-10','passe-15','passe-20'].forEach(id=>document.getElementById(id).value = '');
  renderPasse(currentPlayer);
  renderComparisonViews();
  renderRecap();
});

function renderPasseCompare(name, comparisonGroup){
  const mine = latestPasse(name);
  const dists = [['r10','10 m'],['r15','15 m'],['r20','20 m']];
  const groupVals = { r10: [], r15: [], r20: [] };
  comparisonGroup.forEach(n=>{
    const lp = latestPasse(n);
    if(lp) dists.forEach(([k])=>{ if(lp[k]!=null) groupVals[k].push(lp[k]); });
  });
  const hint = document.getElementById('passe-compare-hint');
  const bars = document.getElementById('passe-compare-bars');
  if(!mine){
    hint.textContent = '';
    bars.innerHTML = '<p class="yoyo-empty">Entrez un résultat pour ce joueur pour voir la comparaison.</p>';
    return;
  }
  const counts = dists.filter(([k])=>groupVals[k].length).map(([k,l])=>`${l} : ${groupVals[k].length}`).join(', ');
  if(!counts){
    hint.textContent = '';
    bars.innerHTML = '<p class="yoyo-empty">Aucune donnée de passe enregistrée pour le groupe sélectionné.</p>';
    return;
  }
  hint.textContent = `Comparé aux résultats les plus récents du groupe sélectionné (nombre d'athlètes par distance — ${counts}).`;
  bars.innerHTML = dists.map(([key,label])=>{
    const v = mine[key];
    if(v==null){
      return `<div class="stat-bar-row">
        <div class="lbl"><span><b>Réussites à ${label}</b></span><span class="val na">non renseigné</span></div>
      </div>`;
    }
    const vals = groupVals[key];
    if(!vals.length){
      return `<div class="stat-bar-row">
        <div class="lbl"><span><b>Réussites à ${label}</b></span><span class="val">${v}</span></div>
        <div class="delta">Aucune donnée du groupe sélectionné à cette distance.</div>
      </div>`;
    }
    const mean = vals.reduce((a,b)=>a+b,0)/vals.length;
    const lo = Math.min(...vals, v), hi = Math.max(...vals, v);
    const range = (hi-lo) || 1;
    const fillPct = Math.max(2, Math.min(100, ((v-lo)/range)*100));
    const avgPct = Math.max(0, Math.min(100, ((mean-lo)/range)*100));
    const color = v >= mean ? '#35c6cf' : '#ff6b47';
    const delta = v - mean;
    const sign = delta>=0?'+':'';
    return `<div class="stat-bar-row">
      <div class="lbl"><span><b>Réussites à ${label}</b></span><span class="val">${v}</span></div>
      <div class="track"><div class="fill" style="width:${fillPct}%; background:${color}"></div><div class="avg-tick" style="left:${avgPct}%"></div></div>
      <div class="delta">${sign}${delta.toFixed(1)} vs moyenne du groupe sélectionné (point = moyenne, ${mean.toFixed(1)}, ${vals.length} athlète${vals.length>1?'s':''})</div>
    </div>`;
  }).join('');
}

document.getElementById('back-btn').addEventListener('click', ()=>{
  currentPlayer = null;
  document.getElementById('player-view').hidden = true;
  document.getElementById('recap-view').hidden = false;
  document.body.classList.remove('in-player');
  renderRoster();
  window.scrollTo(0, recapScroll);
});

